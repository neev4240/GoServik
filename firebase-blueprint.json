{
  "entities": {
    "Professional": {
      "title": "Professional Profile",
      "description": "A verified professional profile on GoServik offering local expert services.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the professional."
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Full name of the professional."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Professional's email address."
        },
        "role": {
          "type": "string",
          "enum": ["professional"],
          "description": "Role classification."
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the profile was created."
        },
        "verified": {
          "type": "boolean",
          "description": "Whether the technician has been verified by the admin."
        },
        "tagline": {
          "type": "string",
          "maxLength": 150,
          "description": "Tagline or pitch."
        },
        "bio": {
          "type": "string",
          "maxLength": 1000,
          "description": "Detailed biography."
        },
        "location": {
          "type": "string",
          "maxLength": 100,
          "description": "Primary city or region."
        },
        "availabilityStatus": {
          "type": "string",
          "enum": ["available", "busy", "offline"],
          "description": "Current dispatch availability."
        }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Booking": {
      "title": "Booking Transaction",
      "description": "A service appointment scheduled between a customer and a professional.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the booking."
        },
        "professionalId": {
          "type": "string",
          "description": "Target professional ID."
        },
        "professionalName": {
          "type": "string",
          "description": "Target professional's name."
        },
        "customerId": {
          "type": "string",
          "description": "Client user ID."
        },
        "customerName": {
          "type": "string",
          "description": "Client's contact name."
        },
        "serviceId": {
          "type": "string",
          "description": "Service reference identifier."
        },
        "serviceName": {
          "type": "string",
          "description": "The specific service being rendered."
        },
        "date": {
          "type": "string",
          "description": "Scheduled appointment date."
        },
        "timeSlot": {
          "type": "string",
          "description": "Scheduled time block."
        },
        "address": {
          "type": "string",
          "maxLength": 500,
          "description": "Physical address where service is performed."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Special customer instructions."
        },
        "totalPrice": {
          "type": "number",
          "description": "Cost in Indian Rupees (₹)."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "completed", "cancelled"],
          "description": "Current lifecycle status of the booking."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Booking creation timestamp."
        }
      },
      "required": ["id", "professionalId", "customerId", "serviceId", "status", "totalPrice"]
    }
  },
  "firestore": {
    "/professionals/{professionalId}": {
      "schema": "Professional",
      "description": "Profiles of listed technicians and service providers."
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Appointments booked between clients and professionals."
    }
  }
}
